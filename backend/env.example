DATABASE_URL=postgresql+asyncpg://usuario:clave@host:5432/base
SQL_ECHO=false
# Orígenes permitidos por CORS, separados por coma, con esquema y sin barra final.
# En producción: el dominio HTTPS del frontend. Para probar en local: el puerto 8080 del contenedor del frontend.
CORS_ORIGINS=https://libreria.dominio.me,http://localhost:8080,http://127.0.0.1:8080
